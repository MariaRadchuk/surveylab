# Шаблон змінних середовища для docker compose. Скопіюйте у .env і змініть пароль.
APP_ENV=development
POSTGRES_USER=surveylab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=surveylab
FRONTEND_PORT=8081
# Спостережуваність (deploy/monitoring): пароль адміністратора Grafana та мережа Compose застосунку
GRAFANA_ADMIN_PASSWORD=change-me
SURVEYLAB_NETWORK=surveylab_default
OTEL_EXPORTER_OTLP_ENDPOINT=
